# =========================================================
# Customer Service Assistant 配置样例
# 用法：复制本文件为 .env，然后填入你自己的密钥（.env 已被 .gitignore 忽略）
#   cp .env.example .env       # Windows PowerShell: Copy-Item .env.example .env
# =========================================================

# ---- 必填：模型与嵌入凭据 ----
# DeepSeek（对话模型）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# SiliconFlow（BGE-M3 嵌入 + bge-reranker 重排）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---- 可选：LangSmith 追踪与实验 ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=customer-service-assistant

# ---- Milvus ----
CSA_MILVUS_URI=http://localhost:19530
CSA_MILVUS_DB=customer_service_assistant
CSA_MILVUS_COLLECTION=customer_service_docs_v2
# P0 对照组使用的 quick-create collection（仅 baseline 对照实验需要）
# CSA_BASELINE_COLLECTION=customer_service_docs

# ---- 知识库（默认读取 data/knowledge/knowledge.txt）----
# CSA_KNOWLEDGE_DIR=./data/knowledge
# CSA_DOC_GLOB=*.txt,*.md
# CSA_DOC_VERSION=2026Q1
# CSA_CHILD_CHUNK_SIZE=300
# CSA_CHILD_CHUNK_OVERLAP=60
# CSA_MAX_TEXT_LENGTH=8192

# ---- 模型 ----
# CSA_LLM_MODEL=deepseek-flash
# CSA_LLM_PROVIDER=deepseek
# CSA_LLM_TEMPERATURE=0
# CSA_LLM_TIMEOUT=60
# CSA_EMBED_MODEL=openai:BAAI/bge-m3
# CSA_EMBED_DIM=1024
# CSA_EMBED_BATCH=32

# ---- 检索：混合检索 + 重排 + 两级阈值 ----
# CSA_RETRIEVAL_MODE=hybrid
# CSA_FUSION=weighted
# CSA_DENSE_WEIGHT=0.2
# CSA_SPARSE_WEIGHT=0.8
# CSA_DENSE_TOP_K=20
# CSA_SPARSE_TOP_K=20
# CSA_RERANK_ENABLED=true
# CSA_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# CSA_RERANK_TOP_N=5
# CSA_RERANK_THRESHOLD=0.02       # 片段过滤：只剔噪声
# CSA_REFUSAL_THRESHOLD=0.22      # 拒答判定：基于最高重排分
# CSA_KEYWORD_EXPANSION=false
# CSA_CONDENSE_WITH_HISTORY=true

# ---- 运行 ----
# CSA_ENABLE_TRACING=false
# CSA_LOG_LEVEL=INFO
# CSA_PROMPT_VERSION=v1
# CSA_MAX_TOOL_CALLS=8
# CSA_SUMMARY_TRIGGER=8000
# 管理接口 /api/v1/ingest 的令牌（留空则该接口禁用）
# CSA_ADMIN_TOKEN=
